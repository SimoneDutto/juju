#!/usr/bin/env bash

# Thin Bash completion adapter for Juju.

_juju_complete() {
    local current cword word

    current="${COMP_WORDS[COMP_CWORD]}"
    cword=${COMP_CWORD}

    local words=("${COMP_WORDS[@]}")
    if (( cword >= ${#words[@]} )); then
        words+=("${current}")
    fi

    local args=(autocomplete --cword "${cword}" --current "${current}")
    for word in "${words[@]}"; do
        args+=(--word "${word}")
    done

    mapfile -t COMPREPLY < <("${words[0]}" "${args[@]}" 2>/dev/null)
}

complete -o default -F _juju_complete juju
complete -o default -F _juju_complete juju-2
